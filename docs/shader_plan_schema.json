{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skyrim-n3ds/docs/shader_plan_schema.json",
  "title": "d9-shader-plan-v1",
  "description": "One offline plan format for pixel and vertex shaders. A document maps exact bytecode SHA-256 values to materialised PICA200 descriptors. Status is derived, not declared: draw_enabled=1 -> 'draw-enabled', kind=tev/pica_vs with draw_enabled=0 -> 'translated', and a census row with no plan -> 'refused'. The verifier (tools/shaders/plan_verify.py) normalises and checks this.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "archive", "entries"],
  "properties": {
    "schema": { "const": "d9-shader-plan-v1" },
    "archive": { "type": "string", "minLength": 1 },
    "generated_for": { "type": "string" },
    "note": { "type": "string" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": {
      "enum": ["translated", "draw-enabled", "refused"],
      "description": "Normalised by the verifier from kind + draw_enabled."
    },
    "family": {
      "enum": ["ui", "blit_post", "sky_water", "terrain", "skinning",
               "lighting", "menu_light", "generic"]
    },
    "entry": {
      "type": "object",
      "required": ["id", "sha256", "stage", "kind", "draw_enabled", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sha1": { "$ref": "#/$defs/sha1" },
        "stage": { "enum": ["ps_3_0", "vs_3_0"] },
        "kind": { "enum": ["tev", "pica_vs"] },
        "draw_enabled": { "enum": [0, 1] },
        "status": { "$ref": "#/$defs/status" },
        "family": { "$ref": "#/$defs/family" },
        "version": { "type": "string", "pattern": "^0x[0-9a-f]{8}$" },
        "source_package": { "type": "string" },
        "source_key": { "type": "string" },
        "instructions": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array" },
        "outputs": { "type": "array" },
        "constants": { "type": "array", "items": { "type": "integer" } },
        "textures": { "type": "array" },
        "stages": { "type": "integer", "minimum": 0, "maximum": 6 },
        "stage_data": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/stage" }
        },
        "constant_ops": {
          "description": "Plan-level derived registers assembled from the c0..c7 SetPixelShaderConstantF bank (docs/SHADER_WORKAROUNDS.md).",
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/constant_op" }
        },
        "passes": {
          "description": "Optional 2..4 pass program for shaders that need more than six TEV stages.  Each pass owns its stage data, textures, constants, inputs and blend/depth state.",
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/pass" }
        },
        "ldr_clamped": { "enum": [0, 1] },
        "requires_alpha_fixup": { "enum": [0, 1] },
        "uses_vertex_color": { "enum": [0, 1] },
        "expandable": { "type": "array", "items": { "type": "string" } },
        "uniform_registers": { "type": "integer", "minimum": 0 },
        "skinning": { "type": "boolean" },
        "codegen": { "type": "string" },
        "emitted_asm": { "type": "string" },
        "emitter": { "$ref": "#/$defs/emitter" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "tev" } } },
          "then": {
            "required": ["stages", "stage_data", "textures", "constants"],
            "properties": {
              "stage": { "const": "ps_3_0" },
              "stages": { "type": "integer", "minimum": 1, "maximum": 6 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "pica_vs" } } },
          "then": {
            "required": ["outputs", "inputs"],
            "properties": {
              "stage": { "const": "vs_3_0" },
              "outputs": { "type": "array", "minItems": 1, "maxItems": 7 },
              "inputs": { "type": "array", "maxItems": 16 },
              "uniform_registers": { "type": "integer", "maximum": 96 }
            }
          }
        },
        {
          "comment": "A PICA VS contract without verified emitted codegen is never draw-enabled.",
          "if": {
            "required": ["kind", "codegen"],
            "properties": { "kind": { "const": "pica_vs" },
                            "codegen": { "not": { "const": "emitted-verified" } } }
          },
          "then": { "properties": { "draw_enabled": { "const": 0 } } }
        },
        {
          "comment": "A draw-enabled PICA VS must carry the full emitter contract: assembly, .shbin SHA-256, plan inputs and the uniform row map.",
          "if": {
            "required": ["kind", "draw_enabled"],
            "properties": { "kind": { "const": "pica_vs" },
                            "draw_enabled": { "const": 1 } }
          },
          "then": {
            "required": ["codegen", "emitted_asm", "emitter"],
            "properties": { "codegen": { "const": "emitted-verified" } }
          }
        }
      ]
    },
    "emitter": {
      "description": "Measured proof for emitted PICA VS code: the compiled .shbin, its SHA-256, the plan inputs it consumes and the PICA uniform rows it addresses.",
      "type": "object",
      "required": ["samples", "tolerance", "max_abs_position", "max_abs_varying",
                   "picasso", "bones", "uniform_rows", "instructions",
                   "shbin", "shbin_sha256", "shbin_bytes", "inputs", "uniforms"],
      "properties": {
        "samples": { "type": "integer", "minimum": 1 },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "max_abs_position": { "type": "number", "minimum": 0 },
        "max_abs_varying": { "type": "number", "minimum": 0 },
        "picasso": { "enum": ["pass", "skipped"] },
        "bones": { "type": "integer", "minimum": 0, "maximum": 32 },
        "uniform_rows": { "type": "integer", "minimum": 1, "maximum": 96 },
        "instructions": { "type": "integer", "minimum": 1 },
        "shbin": { "type": "string", "pattern": "^generated/[^/]+\\.shbin$" },
        "shbin_sha256": { "$ref": "#/$defs/sha256" },
        "shbin_bytes": { "type": "integer", "minimum": 1 },
        "inputs": { "type": "array", "minItems": 1, "maxItems": 16 },
        "uniforms": {
          "type": "array", "minItems": 16,
          "items": {
            "type": "object",
            "required": ["row", "d3d"],
            "properties": {
              "row": { "type": "integer", "minimum": 0 },
              "d3d": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          }
        }
      }
    },
    "constant_op": {
      "type": "object",
      "required": ["src", "op"],
      "anyOf": [{ "required": ["dst_reg"] }, { "required": ["dst"] }],
      "properties": {
        "dst_reg": { "type": "integer", "minimum": 0, "maximum": 31 },
        "dst": { "type": "integer", "minimum": 0, "maximum": 31,
                 "description": "Alias of dst_reg used by earlier pack plans." },
        "op": { "enum": ["pack", "add", "mul", "lerp"] },
        "src": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["reg", "swizzle"],
            "properties": {
              "reg": { "type": "integer", "minimum": 0, "maximum": 31 },
              "swizzle": { "type": "string", "pattern": "^[xyzw]{4}$" },
              "negate": { "enum": [0, 1] }
            }
          }
        }
      }
    },
    "pass": {
      "type": "object",
      "required": ["stage_data", "textures", "constants", "blend", "depth_write"],
      "properties": {
        "stage_data": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": { "$ref": "#/$defs/stage" }
        },
        "textures": { "type": "array", "maxItems": 3 },
        "constants": { "type": "array", "items": { "type": "integer" } },
        "inputs": { "type": "array" },
        "blend": {
          "type": "object",
          "required": ["enable", "src", "dst", "op"],
          "properties": {
            "enable": { "enum": [0, 1] },
            "src": { "type": "integer", "minimum": 1, "maximum": 11 },
            "dst": { "type": "integer", "minimum": 1, "maximum": 11 },
            "op": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        "depth_write": { "enum": [0, 1] }
      }
    },
    "stage": {
      "type": "object",
      "required": ["func_rgb", "func_a", "src_rgb", "src_a", "op_rgb", "op_a"],
      "properties": {
        "word": { "type": "integer", "minimum": 0 },
        "instruction": { "type": "string" },
        "func_rgb": { "type": "integer", "minimum": 0, "maximum": 9 },
        "func_a": { "type": "integer", "minimum": 0, "maximum": 9 },
        "src_rgb": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "integer", "minimum": 0, "maximum": 15 }
        },
        "src_a": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "integer", "minimum": 0, "maximum": 15 }
        },
        "op_rgb": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "enum": [0, 1, 2, 3, 4, 5, 8, 9, 12, 13] }
        },
        "op_a": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "integer", "minimum": 0, "maximum": 7 }
        },        "const_reg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "const_is_literal": { "enum": [0, 1] },
        "const_rgba8": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "scale_rgb": { "enum": [0, 1, 2, 3] },
        "scale_a": { "enum": [0, 1, 2, 3] }
      }
    }
  }
}
